<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#FF0B0D10" android:endColor="#FF2A3550" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="72dp" android:height="72dp">
        <shape android:shape="oval">
            <solid android:color="#FF7AA2FF" />
        </shape>
    </item>
</layer-list>
